# ============================================================
#  exllamav3 OpenAI-compatible server — configuration
#  (read by ./start.sh; restart the server after changes)
# ============================================================

# --- engine install (first run only) ---------------------------
# On first launch start.sh creates .venv and installs the engine:
# inside the engine repo it builds from the local checkout; anywhere
# else (deployment kit) it pip-installs from EXL3_REPO.
# Default = the MiaAI-Lab fork (DFlash2/MTP drafting, NVFP4/FP8 KV,
# aarch64 GB10 + x86 CUDA). EXL3_REPO overrides (git+https://… URL or
# local path).
# TORCH_INDEX_URL overrides the PyTorch wheel index for the GPU torch
# binary (x86 works with the default; GB10/Spark uses cu130).
# TORCH_CUDA_ARCH_LIST pins the extension build arch (GB10: "12.0;12.1";
# x86 auto-detects from the GPU and needs nothing).
# EXL3_REPO=git+https://github.com/MiaAI-Lab/exllamav3
# TORCH_INDEX_URL=https://download.pytorch.org/whl/cu130
# TORCH_CUDA_ARCH_LIST=12.0;12.1

# --- models -------------------------------------------------
# Target model directory (EXL3 quant). Relative to this directory,
# or an absolute path. Downloaded from the Hub automatically if missing.
MODEL_DIR=models/Qwen3.8-27B-EXL3-3.5bpw

# --- Speculative decoding ------------------------------------
# DRAFT selects the drafting method:
#   dflash2 - dedicated 1.4 GB draft model: deepest drafts, best tokens/s,
#             but costs its weights + ~5 KB/token of draft KV cache.
#   mtp     - MTP head inside the main checkpoint (~50 MB): no download,
#             1.4 GB more headroom and ~20% less KV per token -> fits the
#             full native 262k context on a 24 GB card (dflash2 tops out
#             ~220k). Shallower drafts -> fewer tokens/s than dflash2.
#             The logical choice when VRAM/context is the constraint.
#   none    - no drafting: slowest per token, no extra memory.
# Default: mtp (best context per GB; dflash2 is ~15% faster but needs the
# extra draft weights + KV)
# DRAFT=mtp
#
# Optional: draft model location for DRAFT=dflash2 (default below,
# auto-downloaded from the Hub if missing)
# DRAFT_DIR=models/Qwen3.8-27B-DFlash2-EXL3-5.0bpw

# --- Hub downloads -------------------------------------------
# Missing MODEL_DIR / DRAFT_DIR are fetched automatically on start.
# These repos are private: set HF_TOKEN=<a token with read access>
# here, or run `hf auth login` once. Override the repo ids to use a
# mirror of your own.
# HF_TOKEN=hf_xxx
# HF_TARGET_REPO=Mia-AiLab/Qwen3.8-27B-EXL3-3.5bpw
# HF_DRAFT_REPO=Mia-AiLab/Qwen3.8-27B-DFlash2-EXL3-5.0bpw

# --- HTTP ----------------------------------------------------
PORT=8888
# Bind address. 0.0.0.0 = LAN-wide (no auth!), 127.0.0.1 = local only.
HOST=0.0.0.0

# --- cache / context -----------------------------------------
# Total KV cache size in TOKENS = max context the server can hold
# across all conversations. Native limit for Qwen3.8-27B is 262144;
# 1048576 works via the YaRN config variant (see model card).
CONTEXT_SIZE=262144

# KV cache format: none | 8 | 8,4 | fp8 | nvfp4
#   none  = fp16         16 bits/elem
#   8, 8,4 = int8 / asymmetric Hadamard  ~8.5 bits/elem
#   fp8   = E4M3          8 bits/elem
#   nvfp4 = E2M1 + E4M3 block scales, ~4.5 bits/elem (recommended;
#           measured lossless at generation level)
# Cost: ~64 KB/token at fp16, ~18 KB/token at nvfp4
# (only the 16 full-attention layers hold KV).
CACHE_QUANT=nvfp4

# Max GB of GPU (unified) memory for weights + caches.
# DGX Spark (121 GB): 110.   24 GB GPU: 22.
# GPU memory budget in GB. Leave unset (recommended) to auto-detect:
#   discrete GPU (RTX ...) -> VRAM size minus 2 GB headroom
#   GB10 / unified memory   -> available system RAM minus a 16 GB reserve
# Set it explicitly only to partition a shared machine.
# GPU_MEM_GB=110

# CPU second-tier cache size in GB. ACCEPTED BUT NOT YET ACTIVE —
# the spilling tier is planned, not implemented; the value is currently
# inert. Keep 0.
CPU_CACHE_GB=0

# --- notes ---------------------------------------------------
# Concurrency: the server generates ONE request at a time (batch-1
# speculative decoding). Concurrent requests queue automatically and
# are served in order; /health shows the busy flag.
#
# Sampling: requests may set temperature/top_p/top_k; server defaults
# follow Qwen3.8 recommendations (0.6 / 0.95 / 20).

# Parallel nvcc jobs for the one-time CUDA compile (default: 8 on >=8-core/>=32GB machines, else 4)
# MAX_JOBS=4
